# Environment Configurations


# Application Configuration
WEB_PORT=5173

# Reverse Proxy Configuration
REVERSE_PROXY_HTTP_PORT=80
REVERSE_PROXY_HTTPS_PORT=443

# Service Configuration
AIS_PORT=8000
AIS_ENV="development"
PROJECT_NAME="AVLI"
VERSION=1.0
DESCRIPTION=""
API_PREFIX="/api/v1"
DEBUG=false

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173"

# JWT Configuration
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Model Provider Configuration
MODEL_PROVIDER_API_KEY="your-openrouter-api-key"
MODEL_PROVIDER_API_BASE="https://openrouter.ai/api/v1/chat/completions"

# Large Language Model Configuration
LLM_MODEL="deepseek/deepseek-v4-flash"
LLM_TEMPERATURE=0.2
LLM_CONTEXT_BUDGET=2000
LLM_MAX_CALL_RETRIES=3
LLM_TOTAL_TIMEOUT=60
SESSION_NAMING_ENABLED=true

# Long Term Memory Configuration
LONG_TERM_MEMORY_MODEL="deepseek/deepseek-v4-flash"
LONG_TERM_MEMORY_EMBEDDING_MODEL="baai/bge-m3"
LONG_TERM_MEMORY_EMBEDDING_MODEL_PATH=""
LONG_TERM_MEMORY_COLLECTION_NAME="longterm_memory"

# Knowledge Base Configuration
KNOWLEDGE_BASE_EMBEDDING_MODEL="baai/bge-m3"
KNOWLEDGE_BASE_EMBEDDING_MODEL_PATH=""
KNOWLEDGE_BASE_HOST="localhost"
KNOWLEDGE_BASE_PORT=6333
KNOWLEDGE_BASE_CLOUD_URL="https://xxxxxx-xxxxx-xxxxx-xxxx-xxxxxxxxx.us-east.aws.cloud.qdrant.io:6333"
KNOWLEDGE_BASE_CLOUD_API_KEY="your-qdrant-cloud-api-key"
KNOWLEDGE_BASE_COLLECTION_NAME="documents"
KNOWLEDGE_BASE_CHUNK_SIZE=1024
KNOWLEDGE_BASE_CHUNK_OVERLAP=200

# Logging Configuration
LOG_DIR="logs"
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Profiling Configuration (DEBUG only)
PROFILING_DIR="/tmp/fastapi_profiles"
PROFILING_THRESHOLD_SECONDS="2.0"

# Database Configuration
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_DB_NAME="avli-db"
DATABASE_DB_USER="postgres"
DATABASE_DB_PASSWORD="postgres"
DATABASE_DB_POOL_SIZE=20
DATABASE_DB_MAX_OVERFLOW=10
DATABASE_DB_CHECKPOINT_TABLES=[
    "checkpoint_blobs",
    "checkpoint_writes",
    "checkpoints",
]

# Cache Configuration
CACHE_HOST=""
CACHE_PORT=6379
CACHE_DB=0
CACHE_PASSWORD="changeme"
CACHE_MAX_CONNECTIONS=20
CACHE_TTL_SECONDS=60

# Langfuse Configuration
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST="https://cloud.langfuse.com"

# Evaluation Configuration
EVALUATION_API_KEY="your-openrouter-api-key"
EVALUATION_API_URL="https://openrouter.ai/api/v1/chat/completions"
EVALUATION_LLM="deepseek/deepseek-v4-flash"
EVALUATION_SLEEP_TIME=10

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_SECURITY_ADMIN_USER="grafana"
GRAFANA_SECURITY_ADMIN_PASSWORD="changeme"

# Prometheus Configuration
PROMETHEUS_PORT=9091

# Cadvisor Configuration
CADVISOR_PORT=8080

# Loki Configuration
LOKI_PORT=3100

# Alloy Configuration
ALLOY_PORT=12345

# Mem0 Configuration
MEM0_KEY="your-mem0-api-key"
