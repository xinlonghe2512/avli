{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Asset Intelligence Service: Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/apps/asset-intel-service",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Tests: All",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "args": ["-v"],
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Tests: Asset Intelligence Service",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/apps/asset-intel-service",
      "args": ["-v"],
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ],

  "compounds": [
    {
      "name": "Avli: Debug All",
      "configurations": ["Asset Intelligence Service: Debug"],
      "stopAll": true
    }
  ]
}
