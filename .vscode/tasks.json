{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Agents: Dev Server",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/apps/agents"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Ingestor: Dev Server",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 9000",
      "options": {
        "cwd": "${workspaceFolder}/apps/ingestor"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: Start All",
      "dependsOn": [
        "Agents: Dev Server",
        "Ingestor: Dev Server"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "Test: All",
      "type": "shell",
      "command": "uv run pytest",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Test: Agents",
      "type": "shell",
      "command": "uv run pytest",
      "options": {
        "cwd": "${workspaceFolder}/apps/agents"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: Ingestor",
      "type": "shell",
      "command": "uv run pytest",
      "options": {
        "cwd": "${workspaceFolder}/apps/ingestor"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "uv run ruff check .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "uv run ruff format .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "uv run mypy .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Check: All",
      "dependsOn": [
        "Lint",
        "Type Check",
        "Test: All"
      ],
      "dependsOrder": "parallel"
    }
  ]
}