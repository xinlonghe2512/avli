{
  "name": "Avli Development Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspace/avli",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/avli,type=bind",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "adpyke.codesnap",
        "astral-sh.ty",
        "bruno-api-client.bruno",
        "charliermarsh.ruff",
        "docker.docker",
        "eamodio.gitlens",
        "fastapilabs.fastapi-vscode",
        "formulahendry.code-runner",
        "github.vscode-github-actions",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "redis.redis-for-vscode",
        "tombi-toml.tombi",
        "usernamehw.errorlens"
      ],
      "settings": {
        // --- Python & Environment Settings ---
        "python.defaultInterpreterPath": "/workspace/avli/.venv/bin/python",
        "python.terminal.useEnvFile": true,
        "python.terminal.activateEnvironment": true,

        // --- Editor Settings ---
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },

        // --- Ruff Settings ---
        "ruff.path": ["/workspace/avli/.venv/bin/ruff"],
        "ruff.nativeServer": true,

        // --- Testing (Pytest integration) ---
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["apps"],

        // --- File Nesting & UI Cleanliness ---
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.ty_cache": true,
          "**/.ruff_cache": true
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.patterns": {
          "pyproject.toml": "uv.lock, .python-version, requirements*.txt",
          ".env": ".env.*, .env.example"
        }
      }
    }
  },
  "postCreateCommand": "uv sync --all-packages",

  "forwardPorts": [8000, 8001, 6333, 6379],

  "portsAttributes": {
    "8000": {
      "label": "Agents",
      "onAutoForward": "notify"
    },
    "6333": {
      "label": "Qdrant",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    }
  }
}
